{
  "name": "diarlinux",
  "version": "1.0.0",
  "description": "Diario personal cifrado para Linux (inspirado en Diarium)",
  "main": "./out/main/index.js",
  "author": "RutaInfinitax",
  "license": "MIT",
  "homepage": "https://github.com/RutaInfinitax/diarLinux",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev -- --ozone-platform-hint=auto",
    "build": "npm run typecheck && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:linux": "npm run build && electron-builder --linux",
    "dev:seed": "DIARLINUX_DATA=\"$PWD/.dev-data\" DIARLINUX_SEED=1 electron-vite dev -- --ozone-platform-hint=auto",
    "test": "vitest run"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "dbus-next": "^0.10.2",
    "docx": "^9.11.0",
    "hash-wasm": "^4.12.0",
    "marked": "^15.0.12",
    "node-html-parser": "^9.0.4"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-task-item": "^3.31.4",
    "@tiptap/extension-task-list": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "dompurify": "^3.4.16",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "lucide-react": "^1.55.0",
    "playwright-core": "^1.64.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-virtuoso": "^4.18.16",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vitest": "^5.0.3"
  },
  "productName": "diarLinux",
  "desktopName": "diarlinux.desktop"
}
